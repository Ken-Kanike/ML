    "data = [10, 30, 40, 50, 60, 70, 80,]\n",
    "\n",
    "def find_max(data):\n",
    "    max_num = data[0]\n",
    "    for num in data:\n",
    "        if num > max_num:\n",
    "            max_num = num\n",
    "        \n",
    "    return max_num\n",
    "\n",
    "print(find_max(data)) "
   ]
  }
